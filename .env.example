# =====================================================================
# 1. VARIABEL FRONTEND (jika Frontend & Backend dipisah)
# =====================================================================
# Isi dengan URL publik layanan Backend Railway Anda (tanpa garis miring di akhir),
# contoh: https://sipiket-backend-production.up.railway.app
# - Mendukung build-time (VITE_API_BASE_URL) untuk Vercel/Cloudflare/Vite
# - Mendukung runtime injection (API_BASE_URL / VITE_API_BASE_URL) di frontend-server.ts
VITE_API_BASE_URL=""
API_BASE_URL=""

# =====================================================================
# 2. VARIABEL BACKEND (Railway Backend Service)
# =====================================================================
NODE_ENV="production"
PORT="3000"

# Set BACKEND_ONLY="true" (atau jalankan `npm run start:backend`) untuk server API murni
BACKEND_ONLY="true"

# WAJIB di Railway agar data tidak hilang saat redeploy:
# Pasang Railway Volume dengan Mount Path: /data
# Sistem otomatis membaca RAILWAY_VOLUME_MOUNT_PATH (/data) atau DATA_DIR=/data
DATA_DIR="/data"

# Daftar domain Frontend yang diizinkan mengakses Backend (pisahkan dengan koma).
# Mendukung wildcard seperti: https://*.up.railway.app
ALLOWED_ORIGINS=""

# Opsional: HMAC secret kustom untuk token sesi (otomatis dibuat & disimpan di SQLite jika kosong)
SESSION_SECRET=""

# =====================================================================
# 3. VARIABEL AI STUDIO / FULL-STACK LOKAL
# =====================================================================
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
