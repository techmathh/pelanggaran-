rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny all paths unless explicitly matched below
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidUserCloudProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'appRole', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'appRole', 'updatedAt']) &&
        data.uid is string &&
        isValidId(data.uid) &&
        data.uid == request.auth.uid &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 120 &&
        data.appRole in ['developer', 'admin'] &&
        data.updatedAt is timestamp;
    }

    function isValidCloudSnapshot(data) {
      return data.keys().hasAll([
          'ownerId',
          'schoolName',
          'spreadsheetCount',
          'violationCount',
          'summaryDigest',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'schoolName',
          'spreadsheetCount',
          'violationCount',
          'summaryDigest',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerId is string &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.schoolName is string &&
        data.schoolName.size() >= 1 &&
        data.schoolName.size() <= 160 &&
        data.spreadsheetCount is number &&
        data.spreadsheetCount >= 0 &&
        data.violationCount is number &&
        data.violationCount >= 0 &&
        data.summaryDigest is string &&
        data.summaryDigest.size() >= 1 &&
        data.summaryDigest.size() <= 20000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Connection probe document (read-only single doc for boot connectivity verification)
    match /test/{probeId} {
      allow get: if isValidId(probeId) && probeId == 'connection';
      allow list, create, update, delete: if false;
    }

    // Private cloud sync profile per verified Firebase user
    match /cloud_profiles/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if isVerifiedUser() && existing().uid == request.auth.uid;

      allow create: if isValidId(userId) &&
        isOwner(userId) &&
        isValidUserCloudProfile(incoming()) &&
        incoming().uid == userId &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(userId) &&
        isOwner(userId) &&
        isValidUserCloudProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'appRole', 'updatedAt']);

      allow delete: if false;
    }

    // Per-owner cloud backup snapshots (requires parent profile to exist)
    match /cloud_snapshots/{userId}/backups/{backupId} {
      allow get: if isValidId(userId) &&
        isValidId(backupId) &&
        isOwner(userId) &&
        exists(/databases/$(database)/documents/cloud_profiles/$(userId));

      allow list: if isValidId(userId) &&
        isOwner(userId) &&
        existing().ownerId == request.auth.uid;

      allow create: if isValidId(userId) &&
        isValidId(backupId) &&
        isOwner(userId) &&
        isValidCloudSnapshot(incoming()) &&
        incoming().ownerId == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/cloud_profiles/$(userId));

      allow update: if isValidId(userId) &&
        isValidId(backupId) &&
        isOwner(userId) &&
        isValidCloudSnapshot(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'schoolName',
          'spreadsheetCount',
          'violationCount',
          'summaryDigest',
          'updatedAt'
        ]) &&
        exists(/databases/$(database)/documents/cloud_profiles/$(userId));

      allow delete: if isValidId(userId) &&
        isValidId(backupId) &&
        isOwner(userId) &&
        exists(/databases/$(database)/documents/cloud_profiles/$(userId));
    }
  }
}
